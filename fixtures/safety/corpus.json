{
  "corpusVersion": "0.1",
  "description": "Synthetic safety FP/TP corpus for AgentInspect 6.9+",
  "policies": ["development", "share", "strict"],
  "cases": [
    {
      "id": "token-counts",
      "fixture": "token-counts.jsonl",
      "stimulus": "Numeric tokenUsage fields must not be treated as raw prompts or card numbers",
      "expectations": {
        "development": { "mustNotFlag": ["raw-content", "personal-data", "credential"], "status": "SAFE" },
        "share": { "mustNotFlag": ["raw-content", "personal-data", "credential"], "status": "SAFE" },
        "strict": { "mustNotFlag": ["raw-content", "personal-data", "credential"], "status": "SAFE" }
      }
    },
    {
      "id": "uuid-identifier",
      "fixture": "uuid-identifier.jsonl",
      "stimulus": "UUIDs are identifiers, not credit cards",
      "expectations": {
        "development": { "mustNotFlag": ["personal-data"], "status": "SAFE" },
        "share": { "mustNotFlag": ["personal-data"], "mayFlag": ["identifier"], "status": "SAFE WITH WARNINGS" },
        "strict": { "mustNotFlag": ["personal-data"], "mayFlag": ["identifier"], "status": "SAFE WITH WARNINGS" }
      }
    },
    {
